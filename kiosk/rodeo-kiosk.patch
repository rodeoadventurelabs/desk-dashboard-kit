+    if (wantBar && !attached) { windows.addView(bar, position); attached = true; }
+    if (!wantBar && attached) { windows.removeView(bar); attached = false; }
+    if (wantHotspot && !hotspotAttached) { windows.addView(hotspot, hotspotPosition); hotspotAttached = true; }
+    if (!wantHotspot && hotspotAttached) { windows.removeView(hotspot); hotspotAttached = false; }
