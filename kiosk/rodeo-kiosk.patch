+  // Rodeo change: outside the dashboard the bar stays hidden. An invisible tap zone sits in the
+  // bottom-right corner; 5 quick taps there show Back / Dashboard for 15 seconds.
+  static final int TAPS_TO_SHOW = 5;
+  static final long TAP_WINDOW_MS = 3000, SHOW_MS = 15000;
+  private View hotspot;
+  private WindowManager.LayoutParams hotspotPosition;
+  private boolean hotspotAttached, revealed;
+  private int taps;
+  private long firstTap;
+  private final android.os.Handler handler = new android.os.Handler(android.os.Looper.getMainLooper());
+  private final Runnable hideBar = () -> { revealed = false; updateVisibility(); };
+
+  private void ensureHotspot() {
+    if (hotspot != null) return;
+    hotspot = new View(this);
+    hotspot.setBackgroundColor(Color.TRANSPARENT);
+    hotspotPosition = new WindowManager.LayoutParams(dp(120), dp(120),
+        WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY,
+        WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE | WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL,
+        PixelFormat.TRANSLUCENT);
+    hotspotPosition.gravity = Gravity.BOTTOM | Gravity.RIGHT;
+    hotspotPosition.setTitle("Home HQ navigation tap zone");
+    hotspot.setOnTouchListener((view, event) -> {
+      if (event.getActionMasked() != MotionEvent.ACTION_DOWN) return true;
+      long now = android.os.SystemClock.uptimeMillis();
+      if (taps == 0 || now - firstTap > TAP_WINDOW_MS) { taps = 0; firstTap = now; }
+      if (++taps >= TAPS_TO_SHOW) {
+        taps = 0;
+        revealed = true;
+        updateVisibility();
+        handler.removeCallbacks(hideBar);
+        handler.postDelayed(hideBar, SHOW_MS);
+      }
+      return true;
+    });
+  }
+
